    <menuitem id="menu_fd_rules" name="قواعد التوجيه المتقدمة" parent="menu_fd_advanced" action="action_fd_rules" sequence="50"/>
    <menuitem id="menu_fd_coverage" name="فحص التغطية" parent="menu_fd_advanced" action="action_fd_coverage" sequence="60"/>
    <menuitem id="menu_fd_import" name="إرفاق ملف موجود على درايف" parent="menu_fd_advanced" action="action_drive_import" sequence="70"/>
