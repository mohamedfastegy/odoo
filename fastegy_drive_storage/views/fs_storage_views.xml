<odoo>
    <record id="view_drive_storage_list" model="ir.ui.view">
        <field name="name">fastegy.drive.storage.list</field>
        <field name="model">fs.storage</field>
        <field name="arch" type="xml">
            <list string="FastEgy Drive storage">
                <field name="name"/>
                <field name="code"/>
                <field name="fd_connection_checked"/>
                <field name="fd_allow_writes"/>
                <field name="fd_readonly"/>
                <field name="fd_bound_database"/>
            </list>
        </field>
    </record>
    <record id="view_drive_storage_form" model="ir.ui.view">
        <field name="name">fastegy.drive.storage.form</field>
        <field name="model">fs.storage</field>
        <field name="arch" type="xml">
            <form string="FastEgy Google Drive — Trial">
                <header>
                    <button name="action_fd_authorize" type="object" string="Connect Google" class="btn-primary"/>
                    <button name="action_fd_test_connection" type="object" string="Test folder access"/>
                    <button name="action_fd_disconnect" type="object" string="Disconnect" confirm="Disconnect only when no attachment uses this storage."/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        نسخة تجريبية: لا تنقل الملفات تلقائيًا عند التثبيت. ابدأ بسجل واحد.
                        المصادقة تُنشئ مجلدًا خاصًا عند ترك معرف المجلد فارغًا.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not fd_clone_readonly">
                        هذه قاعدة مستنسخة: اتصال المصدر للقراءة فقط. أنشئ مخزنًا منفصلًا للتجربة.
                    </div>
                    <group>
                        <group string="Storage identity">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="protocol" readonly="1"/>
                            <field name="fd_namespace"/>
                            <field name="fd_bound_database"/>
                            <field name="fd_bound_origin"/>
                            <field name="fd_clone_readonly" invisible="1"/>
                        </group>
                        <group string="Google account" groups="base.group_system">
                            <field name="fd_client_id"/>
                            <field name="fd_client_secret" password="True"/>
                            <field name="fd_refresh_token" password="True" readonly="1"/>
                            <field name="fd_redirect_uri" widget="url"/>
                            <field name="fd_root_folder_id"/>
                            <field name="fd_connection_checked"/>
                        </group>
                    </group>
                    <group string="Trial controls">
                        <field name="fd_allow_writes"/>
                        <field name="fd_readonly"/>
                        <field name="fd_max_file_mb"/>
                    </group>
                    <notebook>
                        <page string="Models and fields">
                            <p>اختر الموديلات أو الحقول بعد نجاح اختبار الاتصال. قاعدة الحقل لها الأولوية.</p>
                            <group>
                                <field name="model_ids" widget="many2many" options="{'no_create': True}">
                                    <list><field name="name"/><field name="model"/></list>
                                </field>
                                <field name="field_ids" widget="many2many" domain="[('ttype', '=', 'binary')]" options="{'no_create': True}">
                                    <list><field name="name"/><field name="model"/></list>
                                </field>
                            </group>
                        </page>
                        <page string="Technical guardrails">
                            <group>
                                <field name="is_cacheable" readonly="1"/>
                                <field name="use_filename_obfuscation" readonly="1"/>
                                <field name="autovacuum_gc" readonly="1"/>
                                <field name="use_as_default_for_attachments" readonly="1"/>
                                <field name="directory_path" readonly="1"/>
                            </group>
                            <p>تحتفظ النسخة التجريبية بالملفات البعيدة غير المرتبطة لاستعادة البيانات؛ تنظيفها آليًا معطل.</p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_drive_storage" model="ir.actions.act_window">
        <field name="name">Google Drive storage</field>
        <field name="res_model">fs.storage</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('protocol', '=', 'fastegy_gdrive')]</field>
        <field name="context">{'default_protocol': 'fastegy_gdrive', 'default_is_cacheable': False, 'default_use_filename_obfuscation': True, 'default_autovacuum_gc': False}</field>
    </record>
    <record id="action_drive_storage_list_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_drive_storage_list"/>
        <field name="act_window_id" ref="action_drive_storage"/>
    </record>
    <record id="action_drive_storage_form_view" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_drive_storage_form"/>
        <field name="act_window_id" ref="action_drive_storage"/>
    </record>
    <menuitem id="menu_drive_root" name="FastEgy Drive" parent="base.menu_administration" sequence="90" groups="base.group_system"/>
    <menuitem id="menu_drive_storages" name="Storage connections" parent="menu_drive_root" action="action_drive_storage" sequence="10"/>
</odoo>

