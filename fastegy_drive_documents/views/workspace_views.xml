<odoo>
    <record id="view_fd_workspace_list" model="ir.ui.view"><field name="name">fastegy.drive.workspace.list</field><field name="model">fastegy.drive.workspace</field>
        <field name="arch" type="xml"><list><field name="folder_id"/><field name="storage_id"/><field name="include_subfolders"/><field name="active"/></list></field></record>
    <record id="view_fd_workspace_form" model="ir.ui.view"><field name="name">fastegy.drive.workspace.form</field><field name="model">fastegy.drive.workspace</field>
        <field name="arch" type="xml"><form><header><button name="action_queue_existing" type="object" string="Queue existing workspace files" confirm="Create transfer tasks for this folder scope? Review the queue before running it."/></header>
            <sheet><p>New files follow the closest active folder mapping. Existing files are moved only by explicit transfer tasks. Documents access and sharing remain governed by Odoo.</p>
                <group><field name="folder_id"/><field name="storage_id"/><field name="include_subfolders"/><field name="active"/></group></sheet></form></field></record>
    <record id="action_fd_workspaces" model="ir.actions.act_window"><field name="name">Documents workspaces</field><field name="res_model">fastegy.drive.workspace</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_fd_workspaces" name="Documents workspaces" parent="fastegy_drive_storage.menu_drive_root" action="action_fd_workspaces" sequence="85"/>
</odoo>
